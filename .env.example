# Copy to .env.local for local development. On Vercel, add the same
# variables under Project Settings > Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Web Push public key only. Generate a pair with: npx web-push generate-vapid-keys
# Put the private key in the Supabase secret VAPID_PRIVATE_KEY, never here.
VITE_VAPID_PUBLIC_KEY=
